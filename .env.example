# Copy to .env and fill in one provider's key. Free tiers are enough.

# Default: Google Gemini (free key at https://aistudio.google.com/apikey)
# Flash-Lite: gemini-flash-latest's free tier allows only 20 requests/day (~2 walks)
LLM_MODEL=google_genai:gemini-flash-lite-latest
GOOGLE_API_KEY=
# Requests per minute; keep below your model's free-tier limit
LLM_RPM=4

# Alternative: Groq (free key at https://console.groq.com/keys)
# LLM_MODEL=groq:llama-3.3-70b-versatile
# GROQ_API_KEY=

# Toy app under test
APP_URL=http://localhost:8000
# Planted bugs, comma-separated: allocation,stale_ui,deliver_500 (empty = none)
BUGS=

# Set to false to watch the browser
HEADLESS=true
